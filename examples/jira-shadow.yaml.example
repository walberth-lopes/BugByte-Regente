organization: silverguard
client: squad-tech
workspace: sg

autonomy: L0
shadow: true

root: .regente
policies: ../policies/padrao.yaml

# Referencias que ESTE workspace pode resolver. Valor nenhum vive aqui.
secrets:
  - env:JIRA_EMAIL
  - env:JIRA_API_TOKEN

providers:
  tasks:
    name: jira
    site: https://silverguard.atlassian.net
    # Reproduz respostas reais ja capturadas. Troque para `http` e o mesmo
    # adapter passa a falar com o site, sem outra alteracao.
    transporte: instantaneo
    snapshots: .regente/instantaneos/jira
    user_ref: env:JIRA_EMAIL
    token_ref: env:JIRA_API_TOKEN
    jql: 'project = SG AND statusCategory != Done ORDER BY updated DESC'
    resources_by: parent
  workspace_provider:
    name: diretorio
  runner:
    name: roteiro
  notification:
    name: console

projects:
  - name: SG
    default_environment: staging

limits:
  max_workers: 4
  max_dispatches_per_day: 20
