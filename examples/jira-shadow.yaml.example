organization: silverguard
client: squad-tech
workspace: sg

autonomy: L0
shadow: true

root: .regente
policies: ../policies/default.yaml

# References THIS workspace may resolve. No value ever lives here.
secrets:
  - env:JIRA_EMAIL
  - env:JIRA_API_TOKEN

providers:
  tasks:
    name: jira
    site: https://silverguard.atlassian.net
    # Replays real responses already captured. Switch to `http` and the same
    # adapter talks to the site, with no other change.
    transport: snapshot
    snapshots: .regente/instantaneos/jira
    user_ref: env:JIRA_EMAIL
    token_ref: env:JIRA_API_TOKEN
    jql: 'project = SG AND statusCategory != Done ORDER BY updated DESC'
    resources_by: parent
  workspace_provider:
    name: directory
  runner:
    name: script
  notification:
    name: console

projects:
  - name: SG
    default_environment: staging

limits:
  max_workers: 4
  max_dispatches_per_day: 20
