# Configuracao do Regente. Um arquivo por workspace.
#
# Trocar de fornecedor e editar `providers`. O Core Engine nao muda.

organization: my-org
client: first-client
workspace: main

# Ate onde o motor vai sozinho: L0 leitura, L1 codigo, L2 PR, L3 staging, L4 producao.
autonomy: L2

# Sombra: o motor decide, registra e mostra -- mas nao executa escrita externa.
# Nasce ligado. Desligar e decisao explicita, depois de conferir a sombra.
shadow: true

root: .regente
policies: ../policies/default.yaml

providers:
  tasks:
    name: filesystem
    directory: ./tasks
  workspace_provider:
    name: diretorio
  runner:
    name: roteiro
  notification:
    name: console

projects:
  - name: padrao
    default_environment: staging

limits:
  max_workers: 2
  max_dispatches_per_day: 8

budget:
  max_iterations: 24
  max_tool_calls: 120
  max_cost_usd: 5.0
  max_seconds: 2700
  max_attempts: 3

# Somam aos fatores da base; nao os substituem.
risk_factors: []
