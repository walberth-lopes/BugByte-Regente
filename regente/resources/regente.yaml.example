# Regente configuration. One file per workspace.
#
# Swapping providers means editing `providers`. The Core Engine does not change.

organization: my-org
client: first-client
workspace: main

# How far the engine goes on its own: L0 read, L1 code, L2 PR, L3 staging,
# L4 production.
autonomy: L2

# Shadow: the engine decides, records and shows -- but performs no external
# write. It is born on. Turning it off is an explicit decision, after checking
# what `regente shadow` says it would have done.
shadow: true

root: .regente
policies: ../policies/default.yaml

providers:
  tasks:
    name: filesystem
    directory: ./tasks
  workspace_provider:
    name: directory
  runner:
    name: script
  notification:
    name: console

projects:
  - name: default
    default_environment: staging

limits:
  max_workers: 2
  max_dispatches_per_day: 8

budget:
  max_iterations: 24
  max_tool_calls: 120
  max_cost_usd: 5.0
  max_seconds: 2700
  max_attempts: 3

# These add to the base factors; they do not replace them.
risk_factors: []
